{
  "meta": {
    "description": "Structured patterns for PDF parent field suffixes - Elternteil 1 vs Elternteil 2",
    "version": "1.0.0",
    "total_field_bases": 110,
    "source": "elternteil_suffix_extraktion.json"
  },
  "patterns": {
    "underscore": {
      "id": "pattern_underscore",
      "description": "Most common for income and tax sections",
      "detect_regex": "/_[12]$/",
      "parent1_suffix": "_1",
      "parent2_suffix": "_2",
      "field_count": 42,
      "priority": 1,
      "examples": {
        "parent1": ["txt.steuer2b_1", "cb.EGalt_1"],
        "parent2": ["txt.steuer2b_2", "cb.EGalt_2"]
      }
    },
    "space_digit_1": {
      "id": "pattern_space_digit_right_column",
      "description": "Used for personal data columns (right column = Parent 2)",
      "detect_regex": "/ 1$/",
      "parent1_suffix": "",
      "parent2_suffix": " 1",
      "field_count": 39,
      "priority": 2,
      "examples": {
        "parent1": ["txt.vorname2b", "cb.ja2c"],
        "parent2": ["txt.vorname2b 1", "cb.ja2c 1"]
      }
    },
    "space_digit_2": {
      "id": "pattern_space_digit_ausland",
      "description": "Used for foreign residence sections",
      "detect_regex": "/ 2$/",
      "parent1_suffix": "",
      "parent2_suffix": " 2",
      "field_count": 17,
      "priority": 3,
      "examples": {
        "parent1": ["txt.staat2c", "cb.nein2c"],
        "parent2": ["txt.staat2c 2", "cb.nein2c 2"]
      }
    },
    "trailing_digit": {
      "id": "pattern_trailing_digit",
      "description": "Used for bank and church fields",
      "detect_regex": "/[a-z]1$/",
      "parent1_suffix": "1",
      "parent2_suffix": "2",
      "field_count": 12,
      "priority": 4,
      "examples": {
        "parent1": ["txt.bankcode1", "cb.kirche1", "cb.ich1"],
        "parent2": ["txt.bankcode2", "cb.kirche2", "cb.ich2"]
      }
    }
  },
  "special_cases": {
    "offset_numbering": {
      "description": "Fields where numbering starts at _2/_3 instead of _1/_2",
      "fields": [
        {
          "base": "cb.andereErsatz",
          "parent1": "cb.andereErsatz_2",
          "parent2": "cb.andereErsatz_3"
        },
        {
          "base": "cb.wenigCorona",
          "parent1": "cb.wenigCorona_2",
          "parent2": "cb.wenigCorona_3"
        },
        {
          "base": "cb.pflichkk",
          "parent1": "cb.pflichkk_3",
          "parent2": "cb.pflichkk_4"
        }
      ]
    },
    "unexpected_parent2_digit": {
      "description": "Parent 2 uses unexpected digit (not ...2)",
      "examples": [
        {
          "parent1": "cb.bemessungnein1",
          "parent2": "cb.bemessungnein3"
        }
      ]
    },
    "base_name_mismatch": {
      "description": "Same question but different technical field names between parents",
      "examples": [
        {
          "description": "Gewinneinkünfte Ja/Nein",
          "parent1_yes": "cb.Gewinnja1_1",
          "parent1_no": "cb.Gewinneinkünftenein_1",
          "parent2_yes": "cb.Gewinnja1_3",
          "parent2_no": "cb.Gewinnja1_2"
        }
      ]
    },
    "internal_checkbox_ids": {
      "description": "Generic Acrobat internal IDs - number is NOT a parent suffix",
      "examples": [
        {
          "parent1": "Kontrollkästchen 59",
          "parent2": "Kontrollkästchen 69"
        }
      ],
      "note": "Must be mapped manually, no pattern derivable"
    },
    "lebensmonat_grids": {
      "description": "Lebensmonat tables where number encodes month, not parent",
      "ranges": {
        "BG": {
          "parent1": [1, 18],
          "parent2": [20, 37]
        },
        "E+": {
          "parent1": [1, 18],
          "parent2": [34, 55]
        }
      },
      "examples": [
        {
          "type": "BG",
          "parent1_range": "cb_BG_1..cb_BG_18",
          "parent2_range": "cb_BG_20..cb_BG_37"
        },
        {
          "type": "E+",
          "parent1_range": "cb_E+_1..cb_E+_18",
          "parent2_range": "cb_E+_34..cb_E+_55"
        }
      ]
    },
    "unique_parent2_fields": {
      "description": "Fields that only exist for Parent 2 (no Parent 1 equivalent)",
      "fields": [
        {
          "field": "cb.wohnezusammen2c",
          "label": "Elternteil 2: gleiche Anschrift wie Elternteil 1"
        }
      ]
    }
  },
  "usage": {
    "auto_mapping_priority": [
      "1. Check special_cases first (highest priority)",
      "2. Match pattern by detect_regex in priority order",
      "3. Apply parent1/parent2 suffix transformation",
      "4. Warn if field matches lebensmonat_grids"
    ],
    "get_parent2_field": {
      "description": "Given a Parent 1 field, derive the Parent 2 equivalent",
      "algorithm": [
        "1. Check offset_numbering exceptions",
        "2. Check unique_parent2_fields",
        "3. Try patterns in priority order:",
        "   - If ends with _1 → replace with _2 (underscore pattern)",
        "   - If base field exists without suffix → append ' 1' (space_digit_1)",
        "   - If ends with 1 after letter → replace with 2 (trailing_digit)"
      ]
    }
  }
}
